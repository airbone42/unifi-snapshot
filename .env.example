# Kopieren nach .env bzw. /etc/unifi-snapshot/env (nie committen, Modus 600)

# Adresse der UniFi-Konsole (z. B. UDM), ohne Pfad
UNIFI_HOST=https://192.0.2.1

# Settings > Control Plane > Integrations > Create API Key
# Eigener lokaler Account nur für dieses Tool
UNIFI_API_KEY=

# TLS: am besten das Zertifikat der Konsole pinnen (siehe README).
# UNIFI_VERIFY_TLS=false nur zum ersten Testen.
UNIFI_CA_FILE=/etc/unifi-snapshot/console.pem
# UNIFI_VERIFY_TLS=false

# Inoffizielle Legacy-API mitsichern (PPSK, WireGuard-Peers, Settings, v2-Firewall-Objekte ...)
# Auf false setzen, falls die Konsole den API-Key dort ablehnt.
UNIFI_LEGACY=true
